[Unit]
Description=cz-cli durable Codex maintenance
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/services/cz-cli-maintenance/repo
EnvironmentFile=%h/services/cz-cli-maintenance/service.env
ExecStart=/usr/local/bin/bun scripts/maintenance.ts service run
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=default.target
